<!-- Colonne droite -->
<aside
    class="hidden lg:block lg:w-3/5 bg-black sticky top-0 h-screen w-full flex flex-col items-center overflow-y-auto scrollbar-thin scrollbar-thumb-gray-700 scrollbar-track-black">

    <div class="w-full max-w-md space-y-6 py-6">

        <!-- Barre de recherche -->
        <form action="{{ route('search') }}" method="GET" class="w-full px-4 relative">
            <i class="fa-solid fa-magnifying-glass absolute left-7 top-1/2 -translate-y-1/2 text-gray-400"></i>
            <input type="text" name="q" placeholder="Rechercher un hashtag, un compte..."
                class="w-full rounded-full bg-gray-900 text-white placeholder-gray-500 pl-10 pr-4 py-2 focus:outline-none focus:ring-2 focus:ring-[#1D9BF0]" />
        </form>

        <!-- Si recherche -->
        @if(query)
        <div class="bg-gray-900 rounded-2xl p-4 m-4 text-white">
            <h3 class="text-xl font-bold mb-4">Résultats pour "{{ query }}"</h3>

            <!-- Comptes -->
            <div class="mb-6">
                <h4 class="font-semibold mb-3 text-gray-300">Comptes</h4>
                @if(users.length)
                @each(user in users)
                <div class="flex items-center justify-between mb-3">
                    <div class="flex items-center space-x-3">
                        <img src="{{ user.avatar_url || '/default-avatar.png' }}" alt="avatar"
                            class="w-10 h-10 rounded-full object-cover">
                        <div>
                            <p class="font-semibold">{{ user.name }}</p>
                            <p class="text-gray-500 text-sm">{{ user.pseudo }}</p>
                        </div>
                    </div>
                    <button
                        class="bg-white text-black font-semibold px-3 py-1 rounded-full hover:bg-gray-200 transition">
                        Follow
                    </button>
                </div>
                @endeach
                @else
                <p class="text-gray-500 text-sm">Aucun compte trouvé.</p>
                @endif
            </div>

            <!-- Tweets -->
            <div>
                <h4 class="font-semibold mb-3 text-gray-300">Tweets</h4>
                @if(tweets.length)
                @each(tweet in tweets)
                <div class="border-b border-gray-700 pb-3 mb-3">
                    <p class="text-sm text-gray-400">{{ tweet.user.pseudo }}</p>
                    <p class="text-white">{{ tweet.content }}</p>
                </div>
                @endeach
                @else
                <p class="text-gray-500 text-sm">Aucun tweet trouvé.</p>
                @endif
            </div>
        </div>

        @else
        <!-- Cartes par défaut -->

        <!-- Tendances -->
        <div class="bg-gray-900 rounded-2xl p-4 m-4">
            <h3 class="text-xl font-bold mb-4 text-white">What’s happening</h3>
            <div class="space-y-3">
                <div>
                    <p class="text-gray-400 text-sm">Trending in Tech</p>
                    <p class="font-semibold text-white">#AdonisJS</p>
                </div>
                <div>
                    <p class="text-gray-400 text-sm">Trending in Music</p>
                    <p class="font-semibold text-white">#Afrobeats</p>
                </div>
                <div>
                    <p class="text-gray-400 text-sm">Trending in Sports</p>
                    <p class="font-semibold text-white">#RDCongo</p>
                </div>
            </div>
        </div>

       
    </div>
</div>
        @endif
    </div>
</aside>