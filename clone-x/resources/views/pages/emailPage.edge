<!DOCTYPE html>
<html>
  <head>
    <meta charset="utf-8" />
    <title>
      Bienvenue
    </title>
    <style>
      form {
        margin: 20px auto;
        max-width: 400px;
        padding: 20px;
      }
      
      input[type="email"] {
        width: 100%;
        padding: 10px;
        margin-bottom: 10px;
      }
      
      button {
        padding: 10px 20px;
        background-color: #007bff;
        color: white;
        border: none;
        cursor: pointer;
      }
      
      input[type="text"] {
        width: 100%;
        padding: 10px;
        margin-bottom: 10px;
      }
      
      #liens {
        display: none;
      }
    </style>
  </head>
  <body>
    <form action="/send" method="POST">
      {{ csrfField() }}
        <input
        type="email"
        id="email"
        name="email"
        value="{{ email || '' }}"
        placeholder="Votre adresse email"
        required
      />
      <input
        type="text"
        id="liens"
        name="liens"
        value="http://localhost:3333/modifier"
        placeholder="Liens d'invitation"
        required
      />
      <button type="submit">verifier votre mail</button>
    </form>
  </body>
</html>
