{{-- resources/views/components/sidebar.edge --}}
{{-- Déclare que le composant attend une prop 'currentUser' --}}

<aside
    class=" hidden lg:w-2/5 w-full lg:block bg-black border-r border-gray-800 flex flex-col justify-between  sticky top-0 h-screen">
    <div>
        <div class="p-6 text-white  ">
            <i class="fa-brands fa-x-twitter font-black "></i>
        </div>

        @include('components/main_navigation')
    </div>

    <div class="p-4 border-t border-gray-800">
        <div class="flex items-center gap-3 p-2 rounded-full hover:bg-gray-800">
            <div
                class="w-10 h-10 rounded-full bg-black text-white border border-gray-500 flex items-center justify-center font-medium">
                {{-- Affiche l'initiale de l'utilisateur (première lettre du fullName) --}}
                {{ currentUser ? currentUser.name[0].toUpperCase() : '?' }}

                {{-- LE POINT VERT DE STATUT --}}
                @if(currentUser)
                <span
                    class="absolute  right-0 top-18 left-2 block h-3 w-3 rounded-full ring-2 ring-white bg-blue-500"></span>

                @endif
            </div>
            @if(currentUser)
            <div>
                <p class="font-medium text-sm text-white"> {{ currentUser.name }} </p>
                <p class="text-sm text-gray-500"> {{ currentUser.email }} </p>
            </div>
            @else
            <div>
                <p class="font-medium text-sm"> Utilisateur non connecté </p>
            </div>
            @endif
        </div>


        <form method="POST" action="{{ route('logout') }}" class="mt-2">
            {{ csrfField() }}
            @!component('components/button', { text: 'Déconnexion' })
        </form>

    </div>
</aside>