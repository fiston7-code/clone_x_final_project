    <div class="bg-gray-900 p-6 rounded-2xl shadow-md w-full max-w-md">
        <h1 class="text-2xl font-bold mb-4 text-center">Paramètres de confidentialité</h1>

        <p class="text-gray-400 mb-6 text-center">
